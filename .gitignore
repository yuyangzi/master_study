# ===== 嵌套 Git 仓库 (sleep_classify 已有自己的 .git) =====
# git 默认会识别嵌套 .git 并停止下钻，无需额外配置
# 这里只为防御性兜底
graduation_transfer/sleep_posture/sleep_classify/.git/

# ===== 项目特定 =====
# save_execl.xlsx 由 util/concat_data.py 生成 (17 MB)
graduation_transfer/sleep_posture/sleep_classify/util/save_execl.xlsx
# 训练用原始 xlsx 数据集 (165 个文件)
graduation_transfer/sleep_posture/sleep_classify/after_process_data/after_process_data/*.xlsx
# Sleep-EDF 公开数据集 (.edf 文件 + 元数据)
